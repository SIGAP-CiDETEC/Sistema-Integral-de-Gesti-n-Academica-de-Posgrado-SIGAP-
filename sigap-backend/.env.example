# Conexión a PostgreSQL (usuario y base exclusivos de SIGAP)
DATABASE_URL="postgresql://sigap:CAMBIA_ESTA_CONTRASENA@localhost:5432/sigap?schema=public"
PORT=4000
NODE_ENV=production
# Secreto para firmar las sesiones: genera uno con  openssl rand -base64 48
JWT_SECRET="CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO"
# Carpeta donde se guardan los PDF (fuera de la carpeta pública)
STORAGE_DIR=/opt/sigap/archivos
# Origen del front (si el front y la API comparten dominio por Nginx, basta con ese dominio)
CORS_ORIGIN="https://virtual.cidetec.ipn.mx"
