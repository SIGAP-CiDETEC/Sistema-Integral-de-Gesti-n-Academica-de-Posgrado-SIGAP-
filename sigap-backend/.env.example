# Conexión a PostgreSQL (usuario y base exclusivos de SIGAP)
DATABASE_URL="postgresql://sigap:CAMBIA_ESTA_CONTRASENA@localhost:5432/sigap?schema=public"
PORT=4000
NODE_ENV=production
# Secreto para firmar las sesiones: genera uno con  openssl rand -base64 48
JWT_SECRET="CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO"
# Carpeta donde se guardan los PDF (fuera de la carpeta pública)
STORAGE_DIR=/opt/sigap/archivos
# Origen del front (si el front y la API comparten dominio por Nginx, basta con ese dominio)
CORS_ORIGIN="https://virtual.cidetec.ipn.mx"

# Correo (opcional): sin SMTP_HOST, SIGAP funciona pero no envía correos. Prueba: npm run probar-correo -- tu@ipn.mx
# Microsoft 365 / Outlook del IPN: smtp.office365.com (TI debe activar "SMTP AUTH" para la cuenta)
# Gmail: smtp.gmail.com con una "contraseña de aplicación" (requiere verificación en dos pasos)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USUARIO=""
SMTP_CONTRASENA=""
SMTP_REMITENTE=""
SIGAP_URL="https://virtual.cidetec.ipn.mx"
