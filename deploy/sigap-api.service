# systemd: API de SIGAP. Copiar a /etc/systemd/system/sigap-api.service
[Unit]
Description=SIGAP API (NestJS)
After=network.target postgresql.service

[Service]
Type=simple
User=deployer
WorkingDirectory=/opt/sigap/app/sigap-backend
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
